{
  "name": "boe-auction-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scans every World of Warcraft auction house in a region for current-season BoE gear and publishes a filterable static site to GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "scan": "tsx src/scanner/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "season:lookup": "tsx scripts/season-lookup.ts",
    "season:discover": "tsx scripts/season-discover.ts",
    "bonuses:vendor": "tsx scripts/vendor-bonuses.ts",
    "mock-data": "tsx scripts/mock-data.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
